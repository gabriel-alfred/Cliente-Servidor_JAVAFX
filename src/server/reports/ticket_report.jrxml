				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Propietario]]></text>
			</staticText>
		</band>
	</columnHeader>
	
	<detail>
		<band height="40" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="50" height="40" uuid="c8d9e0f1-a2b3-4c4d-5e6f-7a8b9c0d1e2f"/>
				<box>
