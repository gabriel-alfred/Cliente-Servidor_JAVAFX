<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.DashboardController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="25.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label text="AETHER//DESK" styleClass="app-title" />
                  <Label fx:id="userLabel" text="// SESION ACTIVA" style="-fx-text-fill: #888888; -fx-font-size: 11px;" />
               </children>
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="reloadButton" mnemonicParsing="false" onAction="#handleReload" styleClass="btn-secondary" text="[RECARGAR]" />
                  <Button fx:id="reportButton" mnemonicParsing="false" onAction="#handleGenerateReport" styleClass="btn-secondary" text="[REPORTE PDF]" />
                  <Button fx:id="logsButton" mnemonicParsing="false" onAction="#handleViewLogs" styleClass="btn-secondary" text="[LOGS]" visible="false" managed="false" />
                  <Button fx:id="addTicketButton" mnemonicParsing="false" onAction="#handleAddTicket" styleClass="btn-primary" text="[+ NUEVO TICKET]" />
                  <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" styleClass="btn-danger" text="[SALIR]" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="// BANDEJA DE TICKETS ACTIVOS" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                  <Label text="(Doble clic en una fila para gestionar)" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
               </children>
            </HBox>
            <TableView fx:id="ticketTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="idColumn" prefWidth="60.0" text="#ID" />
                <TableColumn fx:id="titleColumn" prefWidth="240.0" text="TITULO" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="ESTADO" />
                <TableColumn fx:id="creatorColumn" prefWidth="120.0" text="CREADOR" />
                <TableColumn fx:id="assignedColumn" prefWidth="140.0" text="ASIGNADO A" />
                <TableColumn fx:id="dateColumn" prefWidth="160.0" text="FECHA CREACION" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
