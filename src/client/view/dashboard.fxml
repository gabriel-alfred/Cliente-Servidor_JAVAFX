<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.DashboardController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="25.0" styleClass="header-bar" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label text="AETHERDESK" styleClass="app-title" />
                  <Label fx:id="userLabel" text="Conectado como: Usuario" style="-fx-text-fill: -color-text-muted; -fx-font-size: 13;" />
               </children>
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="reloadButton" mnemonicParsing="false" onAction="#handleReload" styleClass="btn-secondary" text="🔄 Recargar" />
                  <Button fx:id="reportButton" mnemonicParsing="false" onAction="#handleGenerateReport" styleClass="btn-primary" text="📄 Reporte PDF" />
                  <Button fx:id="logsButton" mnemonicParsing="false" onAction="#handleViewLogs" styleClass="btn-secondary" text="🖥️ Logs Servidor" visible="false" managed="false" />
                  <Button fx:id="addTicketButton" mnemonicParsing="false" onAction="#handleAddTicket" styleClass="btn-success" text="＋ NUEVO TICKET" />
                  <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" styleClass="btn-danger" text="🚪 Salir" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label text="PANEL DE GESTIÓN" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: -color-text-muted;" />
               </children>
            </HBox>
            <TableView fx:id="ticketTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" maxWidth="80.0" minWidth="60.0" prefWidth="70.0" text="ID" />
                <TableColumn fx:id="colTitle" prefWidth="200.0" text="TÍTULO" />
                  <TableColumn fx:id="colStatus" maxWidth="150.0" minWidth="120.0" prefWidth="130.0" text="ESTADO" />
                  <TableColumn fx:id="colOwner" maxWidth="150.0" minWidth="120.0" prefWidth="130.0" text="CREADOR" />
                  <TableColumn fx:id="colDesc" prefWidth="300.0" text="DESCRIPCIÓN" />
                  <TableColumn fx:id="colActions" maxWidth="120.0" minWidth="100.0" prefWidth="110.0" text="ACCIONES" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" styleClass="status-bar" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="statusLabel" text="Sistema Operativo - Sesión Segura" />
         </children>
         <padding>
            <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
