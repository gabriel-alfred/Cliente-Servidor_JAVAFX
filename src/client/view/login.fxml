<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.LoginController">
   <children>
      <Label text="Iniciar Sesión">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <TextField fx:id="usernameField" promptText="Usuario" maxWidth="300.0" />
      <PasswordField fx:id="passwordField" promptText="Contraseña" maxWidth="300.0" />
      <Label fx:id="errorLabel" textFill="RED" visible="false" />
      <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" text="Entrar" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
