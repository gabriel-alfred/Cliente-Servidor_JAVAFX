<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" styleClass="login-container" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.LoginController" prefWidth="800.0" prefHeight="600.0">
   <children>
      <VBox alignment="CENTER" spacing="25.0" styleClass="login-card" maxWidth="420.0">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="AETHER//DESK" styleClass="login-title" />
                  <Label text="// GESTION DE TICKETS CLIENTE-SERVIDOR" style="-fx-text-fill: #888888; -fx-font-size: 10px;" />
               </children>
            </VBox>
            
            <VBox spacing="15.0">
               <children>
                  <VBox spacing="5.0">
                     <Label text="// USUARIO" style="-fx-font-weight: bold; -fx-font-size: 10px; -fx-text-fill: #888888;" />
                     <TextField fx:id="usernameField" promptText="Nombre de usuario..." maxWidth="Infinity" />
                  </VBox>
                  <VBox spacing="5.0">
                     <Label text="// CONTRASEÑA" style="-fx-font-weight: bold; -fx-font-size: 10px; -fx-text-fill: #888888;" />
                     <PasswordField fx:id="passwordField" promptText="Contraseña..." maxWidth="Infinity" />
                  </VBox>
               </children>
            </VBox>
            
            <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-primary" text="INICIAR SESION →" maxWidth="Infinity" prefHeight="40.0" />
            
            <Label fx:id="errorLabel" style="-fx-text-fill: #ff4444; -fx-font-size: 11px;" text="" visible="false" wrapText="true" />
         </children>
      </VBox>
   </children>
</VBox>
