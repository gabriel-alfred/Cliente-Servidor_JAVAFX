<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="500.0" spacing="25.0" styleClass="login-card" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.TicketFormController">
   <children>
      <VBox spacing="5.0">
         <children>
            <Label fx:id="titleLabel" text="CREAR NUEVO TICKET" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: -color-primary;" />
            <Label text="Completa la información detallada del ticket" style="-fx-text-fill: -color-text-muted;" />
         </children>
      </VBox>
      <VBox spacing="8.0">
         <children>
            <Label text="Título del Problema" style="-fx-font-weight: bold;" />
            <TextField fx:id="titleField" promptText="Ej: Error en acceso a base de datos" maxWidth="Infinity" />
         </children>
      </VBox>
      <VBox spacing="8.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Descripción detallada" style="-fx-font-weight: bold;" />
            <TextArea fx:id="descField" prefHeight="150.0" promptText="Describe paso a paso el problema encontrado..." wrapText="true" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
      <VBox fx:id="statusContainer" spacing="8.0" visible="false" managed="false">
         <children>
            <Label text="Estado de Resolución" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="statusCombo" maxWidth="Infinity" />
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancelar" minWidth="100.0" />
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" styleClass="btn-primary" text="GUARDAR CAMBIOS" minWidth="150.0" />
         </children>
      </HBox>
   </children>
</VBox>
