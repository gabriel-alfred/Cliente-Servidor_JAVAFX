<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.TicketFormController">
   <children>
      <Label text="Crear Nuevo Ticket" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <VBox spacing="5.0">
         <children>
            <Label text="Título:" />
            <TextField fx:id="titleField" promptText="Ingresa un título descriptivo" />
         </children>
      </VBox>
      <VBox spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Descripción:" />
            <TextArea fx:id="descField" prefHeight="200.0" prefWidth="200.0" promptText="Detalla el problema..." wrapText="true" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancelar" />
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Guardar Ticket" />
         </children>
      </HBox>
   </children>
</VBox>
