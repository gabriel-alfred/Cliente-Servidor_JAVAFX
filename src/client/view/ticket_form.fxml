<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="520.0" spacing="20.0" styleClass="login-card" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.TicketFormController">
   <children>
      <VBox spacing="5.0">
         <children>
            <Label fx:id="titleLabel" text="// REGISTRO DE INCIDENCIA" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
            <Label text="Introduce los detalles técnicos de la solicitud" style="-fx-text-fill: #888888; -fx-font-size: 11px;" />
         </children>
      </VBox>
      <VBox spacing="6.0">
         <children>
            <Label text="// TITULO DE LA INCIDENCIA" style="-fx-font-weight: bold; -fx-font-size: 10px; -fx-text-fill: #888888;" />
            <TextField fx:id="titleField" promptText="Ej: Fallo en pasarela de autenticacion..." maxWidth="Infinity" />
         </children>
      </VBox>
      <VBox spacing="6.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="// DESCRIPCION DETALLADA" style="-fx-font-weight: bold; -fx-font-size: 10px; -fx-text-fill: #888888;" />
            <TextArea fx:id="descField" prefHeight="140.0" promptText="Describe paso a paso el problema encontrado..." wrapText="true" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
      <VBox fx:id="statusContainer" spacing="6.0" visible="false" managed="false">
         <children>
            <Label text="// ESTADO DE RESOLUCION" style="-fx-font-weight: bold; -fx-font-size: 10px; -fx-text-fill: #888888;" />
            <ComboBox fx:id="statusCombo" maxWidth="Infinity" />
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" styleClass="btn-secondary" text="[CANCELAR]" minWidth="100.0" />
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" styleClass="btn-primary" text="[GUARDAR TICKET →]" minWidth="160.0" />
         </children>
      </HBox>
   </children>
</VBox>
